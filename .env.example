# --------------------------------------------------------------------
# Général
# --------------------------------------------------------------------

# Fuseau horaire commun aux conteneurs.
TZ=Europe/Paris

# --------------------------------------------------------------------
# n8n
# --------------------------------------------------------------------

# Exposition de n8n sur la machine locale ou via un reverse proxy.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Clé utilisée par n8n pour chiffrer ses secrets internes.
# Utiliser une valeur longue, aléatoire et stable dans le temps.
N8N_ENCRYPTION_KEY=remplacez-par-une-cle-longue-et-aleatoire

# URL publique ou locale d’accès à l’éditeur n8n.
N8N_EDITOR_BASE_URL=http://localhost:5678

# --------------------------------------------------------------------
# SMTP
# --------------------------------------------------------------------

# Paramètres SMTP pour l’envoi des synthèses.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=automation@example.com
SMTP_PASSWORD=changez-moi
# Conserver les guillemets si l’expéditeur contient des espaces.
SMTP_FROM="Repo Ops <automation@example.com>"
SMTP_TO=destinataire@example.com

# --------------------------------------------------------------------
# GitHub / Renovate
# --------------------------------------------------------------------

# Jeton GitHub avec droits suffisants pour lire les dépôts ciblés
# et ouvrir des branches / pull requests sur ceux-ci.
GITHUB_TOKEN=ghp_remplacer

# Optionnel : jeton dédié à github.com si vous souhaitez le séparer du jeton principal.
# En première approche, il peut rester identique à GITHUB_TOKEN.
RENOVATE_GITHUB_COM_TOKEN=

# Base URL de l'API GitHub.
# Conserver https://api.github.com/ pour github.com.
GITHUB_API_BASE_URL=https://api.github.com/

# Allowlist explicite des dépôts pris en charge, séparés par des virgules.
# Exemple : owner/repo-a,owner/repo-b
RENOVATE_REPOSITORIES=owner/repo-a,owner/repo-b

# Fenêtre de temps utilisée par le worker pour compter les PR Renovate fusionnées récemment.
GITHUB_RECENT_MERGED_WINDOW_DAYS=7

# Mode prudent recommandé au premier démarrage.
# Valeurs utiles : full, lookup, extract. Laisser vide pour exécuter réellement.
RENOVATE_DRY_RUN=full

# Renovate est déclenché explicitement dans ce lot, par exemple via :
# docker compose --profile maintenance run --rm renovate

# Niveau de journalisation global.
LOG_LEVEL=info

# --------------------------------------------------------------------
# Worker .NET
# --------------------------------------------------------------------

# Le worker .NET devient progressivement la couche métier principale.
# Il reste en veille légère dans Docker Compose et produit les artefacts
# lorsqu'un trigger est déposé par n8n.
WORKER_LOOP_INTERVAL_SECONDS=10
WORKER_REPORT_OUTPUT_PATH=/app/reports/worker-summary.json
WORKER_SUMMARY_TEXT_OUTPUT_PATH=/app/reports/worker-summary.txt
WORKER_SUMMARY_HTML_OUTPUT_PATH=/app/reports/worker-summary.html
WORKER_TRIGGER_FILE_PATH=/app/runtime/daily-maintenance.trigger

# Exécution explicite de Renovate supervisée par le worker .NET.
# Ces variables servent surtout aux runs explicites lancés depuis l'hôte
# via `dotnet run` ou `dotnet ...RepoOps.Worker.dll --run-renovate`.
# Le workflow quotidien n8n ne déclenche pas Renovate automatiquement.
RENOVATE_EXECUTION_COMMAND=docker
RENOVATE_EXECUTION_ARGUMENTS=compose --profile maintenance run --rm renovate
RENOVATE_EXECUTION_TIMEOUT_SECONDS=1800
RENOVATE_EXECUTION_MAX_CAPTURED_LINES=200
RENOVATE_EXECUTION_OUTPUT_PATH=reports/renovate-execution.json
RENOVATE_EXECUTION_WORKING_DIRECTORY=

# --------------------------------------------------------------------
# PostgreSQL
# --------------------------------------------------------------------

# Base PostgreSQL utilisée par n8n.
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changez-moi

# --------------------------------------------------------------------
# Réserve pour un reverse proxy éventuel
# --------------------------------------------------------------------

# Variables conservées pour une éventuelle protection amont.
# Elles ne sont pas consommées directement par la stack locale actuelle.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changez-moi
