# Fuseau horaire commun aux conteneurs.
TZ=Europe/Paris

# Exposition de n8n sur la machine locale ou via un reverse proxy.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Variables conservées pour une éventuelle protection amont via reverse proxy.
# Elles ne sont pas consommées directement par n8n 1.x.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changez-moi

# Clé utilisée par n8n pour chiffrer ses secrets internes.
# Utiliser une valeur longue, aléatoire et stable dans le temps.
N8N_ENCRYPTION_KEY=remplacez-par-une-cle-longue-et-aleatoire

# URL publique ou locale d’accès à l’éditeur n8n.
N8N_EDITOR_BASE_URL=http://localhost:5678

# Paramètres SMTP pour l’envoi des synthèses.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=automation@example.com
SMTP_PASSWORD=changez-moi
SMTP_FROM="Repo Ops <automation@example.com>"
SMTP_TO=destinataire@example.com

# Jeton GitHub avec droits suffisants pour lire les dépôts ciblés
# et ouvrir des branches / pull requests sur ceux-ci.
GITHUB_TOKEN=ghp_remplacer

# Optionnel : jeton dédié à github.com si vous souhaitez le séparer du jeton principal.
# En première approche, il peut rester identique à GITHUB_TOKEN.
RENOVATE_GITHUB_COM_TOKEN=

# Allowlist explicite des dépôts pris en charge, séparés par des virgules.
# Exemple : owner/repo-a,owner/repo-b
RENOVATE_REPOSITORIES=owner/repo-a,owner/repo-b

# Mode prudent recommandé au premier démarrage.
# Valeurs utiles : full, lookup, extract. Laisser vide pour exécuter réellement.
RENOVATE_DRY_RUN=full

# Niveau de journalisation global.
LOG_LEVEL=info

# Base PostgreSQL utilisée par n8n.
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changez-moi

# Intervalle en secondes entre deux exécutions en mode scheduled.
RENOVATE_INTERVAL_SECONDS=86400
