# --------------------------------------------------------------------
# Général
# --------------------------------------------------------------------

# Fuseau horaire commun aux conteneurs.
TZ=Europe/Paris

# --------------------------------------------------------------------
# n8n
# --------------------------------------------------------------------

# Exposition de n8n sur la machine locale ou via un reverse proxy.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Clé utilisée par n8n pour chiffrer ses secrets internes.
# Utiliser une valeur longue, aléatoire et stable dans le temps.
N8N_ENCRYPTION_KEY=remplacez-par-une-cle-longue-et-aleatoire

# URL publique ou locale d’accès à l’éditeur n8n.
N8N_EDITOR_BASE_URL=http://localhost:5678

# --------------------------------------------------------------------
# SMTP
# --------------------------------------------------------------------

# Paramètres SMTP pour l’envoi des synthèses.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=automation@example.com
SMTP_PASSWORD=changez-moi
# Conserver les guillemets si l’expéditeur contient des espaces.
SMTP_FROM="Repo Ops <automation@example.com>"
SMTP_TO=destinataire@example.com

# --------------------------------------------------------------------
# GitHub / Renovate
# --------------------------------------------------------------------

# Jeton GitHub avec droits suffisants pour lire les dépôts ciblés,
# ouvrir des branches / pull requests sur ceux-ci et lire les Dependabot alerts
# lorsque cette information est exposée pour le dépôt ciblé.
GITHUB_TOKEN=ghp_remplacer

# Optionnel : jeton dédié à github.com si vous souhaitez le séparer du jeton principal.
# En première approche, il peut rester identique à GITHUB_TOKEN.
RENOVATE_GITHUB_COM_TOKEN=

# Base URL de l'API GitHub.
# Conserver https://api.github.com/ pour github.com.
GITHUB_API_BASE_URL=https://api.github.com/

# Allowlist explicite des dépôts pris en charge, séparés par des virgules.
# Exemple : owner/repo-a,owner/repo-b
RENOVATE_REPOSITORIES=owner/repo-a,owner/repo-b

# Fenêtre de temps utilisée par le worker pour compter les PR Renovate fusionnées récemment.
GITHUB_RECENT_MERGED_WINDOW_DAYS=7

# Mode prudent recommandé au premier démarrage.
# Valeurs utiles : full, lookup, extract. Laisser vide pour exécuter réellement.
RENOVATE_DRY_RUN=full

# Renovate est déclenché explicitement dans ce lot, par exemple via :
# docker compose --profile maintenance run --rm renovate

# Niveau de journalisation global.
LOG_LEVEL=info

# --------------------------------------------------------------------
# Worker .NET
# --------------------------------------------------------------------

# Le worker .NET devient progressivement la couche métier principale.
# Il expose désormais une API HTTP locale interne au réseau Docker.
WORKER_HTTP_PORT=8080
WORKER_EXECUTION_TIMEOUT_SECONDS=1800
WORKER_REPORT_OUTPUT_PATH=/app/reports/worker-summary.json
WORKER_SUMMARY_TEXT_OUTPUT_PATH=/app/reports/worker-summary.txt
WORKER_SUMMARY_HTML_OUTPUT_PATH=/app/reports/worker-summary.html
# Historique léger des runs du worker.
WORKER_RUN_HISTORY_DIRECTORY_PATH=/app/reports/history
WORKER_RUN_HISTORY_INDEX_PATH=/app/reports/history/index.json
WORKER_RUN_HISTORY_RETENTION_COUNT=100
WORKER_HISTORY_VIEW_COUNT=10
WORKER_SUPERVISOR_OUTPUT_PATH=/app/reports/supervisor-decisions.json
WORKER_SUPERVISOR_DIGEST_OUTPUT_PATH=/app/reports/supervisor-decisions.txt
WORKER_SUPERVISOR_PROMPT_OUTPUT_PATH=/app/reports/supervisor-prompts.json
WORKER_SUPERVISOR_PROMPT_DIGEST_OUTPUT_PATH=/app/reports/supervisor-prompts.txt

# Exécuteur contrôlé des prompts superviseur.
# Seul le mode stub est pris en charge dans ce lot.
# Il produit des réponses structurées sans appeler Codex.
CODEX_EXECUTOR_MODE=stub
CODEX_RESPONSE_OUTPUT_PATH=/app/reports/supervisor-codex-responses.json
CODEX_RESPONSE_DIGEST_OUTPUT_PATH=/app/reports/supervisor-codex-responses.txt

# Validation humaine des réponses superviseur.
# Le mode interactif est destiné à un lancement manuel en CLI.
VALIDATION_OUTPUT_PATH=/app/reports/supervisor-validations.json
VALIDATION_DIGEST_OUTPUT_PATH=/app/reports/supervisor-validations.txt
VALIDATION_INPUT_RESPONSE_PATH=/app/reports/supervisor-codex-responses.json
VALIDATION_INPUT_FILE_PATH=
VALIDATION_INTERACTIVE_MODE=false

# Commit Engine contrôlé.
# Il ne doit être activé en réel qu'après validation humaine explicite.
# Le mode dry-run reste activé par défaut.
COMMIT_ENGINE_ENABLED=true
COMMIT_ENGINE_ALLOW_REAL_EXECUTION=false
COMMIT_ENGINE_DRY_RUN_ENABLED=true
COMMIT_ENGINE_CREATE_PULL_REQUEST=true
COMMIT_ENGINE_REQUIRE_CLEAN_WORKTREE=true
COMMIT_ENGINE_OUTPUT_PATH=/app/reports/supervisor-commit-executions.json
COMMIT_ENGINE_DIGEST_OUTPUT_PATH=/app/reports/supervisor-commit-executions.txt
COMMIT_ENGINE_INPUT_RESPONSE_PATH=/app/reports/supervisor-codex-responses.json
COMMIT_ENGINE_INPUT_VALIDATION_PATH=/app/reports/supervisor-validations.json
# Fichier JSON local décrivant le mapping dépôt -> workspace local.
# En exécution Compose, utiliser par exemple /app/config/repository-workspaces.json
COMMIT_ENGINE_WORKSPACE_MAP_PATH=
# Répertoire racine optionnel pour les clones temporaires de travail.
COMMIT_ENGINE_TEMPORARY_WORKSPACE_ROOT_PATH=
COMMIT_ENGINE_BRANCH_PREFIX=repo-ops
COMMIT_ENGINE_PUSH_REMOTE=origin
COMMIT_ENGINE_DEFAULT_BASE_BRANCH=main
# Validation avant commit dans le clone temporaire.
# Si aucune commande n'est fournie et qu'un dépôt .NET est détecté,
# le moteur tente `dotnet build --nologo`.
COMMIT_ENGINE_PRECOMMIT_VALIDATION_ENABLED=true
COMMIT_ENGINE_VALIDATION_COMMAND=
COMMIT_ENGINE_VALIDATION_ARGUMENTS=
COMMIT_ENGINE_VALIDATION_TIMEOUT_SECONDS=600

# Première couche de superviseur IA : elle produit des décisions structurées
# à partir du rapport existant, sans exécuter automatiquement ces décisions.

# Déploiement local explicite depuis la démo ou le worker.
# Le bouton vise la machine sur laquelle le worker tourne.
# En pratique, ce scénario est surtout prévu quand le worker est lancé
# sur l'hôte via `dotnet run`, pas lorsqu'il tourne dans le conteneur Docker.
DEPLOYMENT_ENABLED=true
DEPLOYMENT_DRY_RUN_ENABLED=true
DEPLOYMENT_TARGET_NAME=Machine locale
DEPLOYMENT_COMMAND=powershell
DEPLOYMENT_ARGUMENTS=-NoProfile -ExecutionPolicy Bypass -File scripts/deploy-local.ps1
DEPLOYMENT_DRY_RUN_ARGUMENTS=-DryRun
DEPLOYMENT_TIMEOUT_SECONDS=1200
DEPLOYMENT_WORKING_DIRECTORY=
DEPLOYMENT_OUTPUT_PATH=reports/deployment-execution.json

# Exécution explicite de Renovate supervisée par le worker .NET.
# Ces variables servent surtout aux runs explicites lancés depuis l'hôte
# via `dotnet run` ou `dotnet ...RepoOps.Worker.dll --run-renovate`.
# Le workflow quotidien n8n ne déclenche pas Renovate automatiquement.
RENOVATE_EXECUTION_COMMAND=docker
RENOVATE_EXECUTION_ARGUMENTS=compose --profile maintenance run --rm renovate
RENOVATE_EXECUTION_TIMEOUT_SECONDS=1800
RENOVATE_EXECUTION_MAX_CAPTURED_LINES=200
RENOVATE_EXECUTION_OUTPUT_PATH=reports/renovate-execution.json
RENOVATE_EXECUTION_WORKING_DIRECTORY=

# Politique d'auto-merge contrôlé pour les PR Renovate.
# La décision est toujours calculée par le worker.
# Le merge réel n'est exécuté que si AUTOMERGE_ENABLED=true
# et AUTOMERGE_DRY_RUN_ENABLED=false.
AUTOMERGE_ENABLED=false
AUTOMERGE_DRY_RUN_ENABLED=true
# Valeurs séparées par des virgules : patch,minor,major
AUTOMERGE_ALLOWED_UPDATE_TYPES=patch
# États GitHub acceptés pour autoriser un merge réel.
AUTOMERGE_ALLOWED_MERGEABLE_STATES=clean
# Méthodes GitHub usuelles : merge, squash, rebase
AUTOMERGE_MERGE_METHOD=squash
# Fichier JSON optionnel pour des overrides par dépôt.
# En exécution Compose, utiliser par exemple /app/config/automerge.policies.json
AUTOMERGE_POLICY_FILE_PATH=

# --------------------------------------------------------------------
# PostgreSQL
# --------------------------------------------------------------------

# Base PostgreSQL utilisée par n8n.
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changez-moi

# --------------------------------------------------------------------
# Réserve pour un reverse proxy éventuel
# --------------------------------------------------------------------

# Variables conservées pour une éventuelle protection amont.
# Elles ne sont pas consommées directement par la stack locale actuelle.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changez-moi
