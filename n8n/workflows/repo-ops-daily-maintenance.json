{
  "name": "repo-ops - Maintenance quotidienne",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        220,
        180
      ],
      "id": "1f5f95ab-0a54-40c3-9d11-2bc1f9f9b201",
      "name": "Déclenchement manuel"
    },
    {
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyDay",
              "hour": 7,
              "minute": 0
            }
          ]
        }
      },
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        220,
        360
      ],
      "id": "9e83ab04-8cd2-4378-8bc1-dfd839ca7e18",
      "name": "Cron quotidien"
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst runDateDisplay = new Intl.DateTimeFormat(\"fr-FR\", {\n  dateStyle: \"full\",\n  timeStyle: \"short\",\n  timeZone: \"Europe/Paris\",\n}).format(now);\n\nconst workerApiUrl = \"http://worker:8080/maintenance/run\";\nconst workerRequestBody = {\n  inputSource: \"n8n-http\",\n  triggerRenovateExecution: false,\n};\n\nreturn [\n  {\n    json: {\n      workflowName: \"repo-ops - maintenance quotidienne\",\n      runDateIso: now.toISOString(),\n      runDateDisplay,\n      workerApiUrl,\n      workerRequestBody,\n      mailFrom: \"__CONFIGURER_FROM_DANS_N8N__\",\n      mailTo: \"__CONFIGURER_TO_DANS_N8N__\",\n      workflowNotes: [\n        \"Le workflow appelle directement l'API HTTP locale du worker .NET.\",\n        \"Le worker retourne le rapport JSON dans la réponse HTTP.\",\n        \"Remplacer les marqueurs __CONFIGURER_*__ et associer un credential SMTP avant activation.\"\n      ],\n      workflowLogs: [\n        \"[workflow] Contexte d'exécution préparé.\",\n        \"[workflow] Le worker est déclenché par HTTP sur le réseau Docker interne.\",\n        \"[workflow] n8n réutilise ensuite le digest déjà produit par le worker.\"\n      ]\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        270
      ],
      "id": "3f6fb758-4fef-4b22-a3f6-c983baf0d1d4",
      "name": "Préparer le contexte"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.workerApiUrl }}",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ JSON.stringify($json.workerRequestBody) }}",
        "options": {
          "ignoreResponseCode": true,
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        270
      ],
      "id": "063bc172-c84e-4f6c-ac5e-49fdd5d31a27",
      "name": "Appeler l'API du worker"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst report = data.body ?? data;\n\nif (!report || typeof report !== \"object\") {\n  throw new Error(\"La réponse HTTP du worker ne contient pas de JSON exploitable.\");\n}\n\nreturn [\n  {\n    json: {\n      report,\n      reportStatusCode: data.statusCode ?? 200,\n      reportHeaders: data.headers ?? {}\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        270
      ],
      "id": "4bb0b39f-e098-46ad-a932-0dd3ea767fb0",
      "name": "Analyser le rapport"
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1280,
        270
      ],
      "id": "d0fd4d0d-cd48-4d93-92fe-ff81f367ec3c",
      "name": "Fusionner le contexte et le rapport"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst report = data.report ?? {};\nconst digest = report.digest ?? {};\n\nreturn [\n  {\n    json: {\n      ...data,\n      emailSubject: digest.subject ?? `[repo-ops] Synthèse maintenance du ${data.runDateDisplay}`,\n      emailText: digest.plainTextBody ?? \"Synthèse indisponible.\",\n      emailHtml: digest.htmlBody ?? \"<html lang=\\\"fr\\\"><body><p>Synthèse indisponible.</p></body></html>\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        270
      ],
      "id": "37939d50-9277-4bb5-a151-410d4696f577",
      "name": "Préparer l'email"
    },
    {
      "parameters": {
        "fromEmail": "={{ $json.mailFrom }}",
        "toEmail": "={{ $json.mailTo }}",
        "subject": "={{ $json.emailSubject }}",
        "emailFormat": "both",
        "text": "={{ $json.emailText }}",
        "html": "={{ $json.emailHtml }}",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1760,
        270
      ],
      "id": "b3662d88-5efd-41f0-a984-a65c52532eb7",
      "name": "Envoyer le récapitulatif",
      "credentials": {}
    }
  ],
