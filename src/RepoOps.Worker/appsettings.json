{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RepoOps": {
    "GitHub": {
      "ApiBaseUrl": "https://api.github.com/",
      "RecentMergedWindowDays": 7,
      "UserAgent": "RepoOps.Worker"
    },
    "Renovate": {
      "Command": "docker",
      "Arguments": "compose --profile maintenance run --rm renovate",
      "TimeoutSeconds": 1800,
      "MaxCapturedLines": 200,
      "OutputPath": "reports/renovate-execution.json",
      "WorkingDirectory": ""
    },
    "Worker": {
      "ContinuousModeEnabled": true,
      "RunOnStartup": false,
      "LoopIntervalSeconds": 30,
      "InputSource": "worker-dotnet",
      "TriggerRenovateExecution": false,
      "EmitJsonToStdout": false,
      "ReportOutputPath": "reports/worker-summary.json",
      "SummaryTextOutputPath": "reports/worker-summary.txt",
      "SummaryHtmlOutputPath": "reports/worker-summary.html",
      "TriggerFilePath": "runtime/daily-maintenance.trigger"
    }
  }
}
