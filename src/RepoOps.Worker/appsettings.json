{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RepoOps": {
    "GitHub": {
      "ApiBaseUrl": "https://api.github.com/",
      "RecentMergedWindowDays": 7,
      "UserAgent": "RepoOps.Worker"
    },
    "Renovate": {
      "Command": "docker",
      "Arguments": "compose --profile maintenance run --rm renovate",
      "TimeoutSeconds": 1800,
      "MaxCapturedLines": 200,
      "OutputPath": "reports/renovate-execution.json",
      "WorkingDirectory": ""
    },
    "AutoMerge": {
      "Enabled": false,
      "DryRunEnabled": true,
      "MergeMethod": "squash",
      "AllowedUpdateTypes": [ "patch" ],
      "AllowedMergeableStates": [ "clean" ],
      "PolicyFilePath": "",
      "RepositoryPolicies": []
    },
    "Codex": {
      "Mode": "Stub",
      "OutputPath": "reports/supervisor-codex-responses.json",
      "DigestOutputPath": "reports/supervisor-codex-responses.txt",
      "InputPromptPath": "reports/supervisor-prompts.json"
    },
    "Validation": {
      "OutputPath": "reports/supervisor-validations.json",
      "DigestOutputPath": "reports/supervisor-validations.txt",
      "InputResponsePath": "reports/supervisor-codex-responses.json",
      "InputValidationPath": null,
      "InteractiveMode": false
    },
    "Commit": {
      "Enabled": true,
      "AllowRealExecution": false,
      "DryRunEnabled": true,
      "CreatePullRequest": true,
      "RequireCleanWorktree": true,
      "OutputPath": "reports/supervisor-commit-executions.json",
      "DigestOutputPath": "reports/supervisor-commit-executions.txt",
      "InputResponsePath": "reports/supervisor-codex-responses.json",
      "InputValidationPath": "reports/supervisor-validations.json",
      "WorkspaceMapPath": "",
      "TemporaryWorkspaceRootPath": "",
      "BranchPrefix": "repo-ops",
      "PushRemote": "origin",
      "DefaultBaseBranch": "main",
      "PreCommitValidationEnabled": true,
      "PreCommitValidationCommand": "",
      "PreCommitValidationArguments": "",
      "PreCommitValidationTimeoutSeconds": 600
    },
    "Worker": {
      "HttpPort": 8080,
      "ExecutionTimeoutSeconds": 1800,
      "InputSource": "worker-dotnet",
      "TriggerRenovateExecution": false,
      "EmitJsonToStdout": false,
      "ReportOutputPath": "reports/worker-summary.json",
      "SummaryTextOutputPath": "reports/worker-summary.txt",
      "SummaryHtmlOutputPath": "reports/worker-summary.html",
      "RunHistoryDirectoryPath": "reports/history",
      "RunHistoryIndexPath": "reports/history/index.json",
      "RunHistoryRetentionCount": 100,
      "HistoryViewCount": 10,
      "SupervisorOutputPath": "reports/supervisor-decisions.json",
      "SupervisorDigestOutputPath": "reports/supervisor-decisions.txt",
      "SupervisorPromptOutputPath": "reports/supervisor-prompts.json",
      "SupervisorPromptDigestOutputPath": "reports/supervisor-prompts.txt",
      "SupervisorInputReportPath": null,
      "SupervisorInputDecisionPath": null
    }
  }
}
